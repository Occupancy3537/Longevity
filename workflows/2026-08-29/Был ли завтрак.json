    {
      "parameters": {
        "jsCode": "// Получаем текущую дату по Владивостоку (UTC+10)\nconst today = new Date(new Date().getTime() + 10 * 3600 * 1000);\nconst dd = String(today.getUTCDate()).padStart(2, '0');\nconst mm = String(today.getUTCMonth() + 1).padStart(2, '0');\nconst yyyy = today.getUTCFullYear();\n\n// Формируем возможные форматы даты, которые могут прийти из таблицы\nconst f1 = `${yyyy}-${mm}-${dd}`; // 2026-08-20\nconst f2 = `${dd}.${mm}.${yyyy}`; // 20.08.2026\nconst f3 = `${dd}/${mm}/${yyyy}`; // 20/08/2026\n\n// Проверяем, есть ли хотя бы одна запись за сегодня\nconst hasBreakfast = $input.all().some(item => {\n  const d = String(item.json['Date'] || item.json['Дата'] || '');\n  return d.includes(f1) || d.includes(f2) || d.includes(f3);\n});\n\n// Отдаем результат в формате JSON для вебхука\nreturn { json: { breakfast_ready: hasBreakfast } };"
      },
