    {
      "parameters": {
        "jsCode": "// Получаем текст из сообщения\nconst input = $input.first().json;\nconst userText = input.message?.text || '';\n\nreturn {\n  json: {\n    prompt: `Ты нутрициолог. Пользователь описал еду текстом: \"${userText}\". \n    Оцени вес, способ приготовления, рассчитай БЖУ и микроэлементы.\n    Верни ТОЛЬКО JSON в формате: {\"Meal_description\": \"описание, вес\", \"Calories\": 0, \"Proteins\": 0, \"Carbs\": 0, \"Fats\": 0, \"Магний\": 0, \"Витамин D\": 0, \"Омега-3 (EPA/DHA)\": 0, \"Селен\": 0, \"Йод\": 0, \"Калий\": 0, \"Железо\": 0, \"Кальций\": 0, \"Витамин B12\": 0, \"Витамин К\": 0, \"Витамин Е\": 0, \"Цинк\": 0}`,\n    hasImage: false,\n    userText: userText\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        672
      ],
      "id": "98114e12-f22b-4739-8d06-b21d28ddf3a0",
      "name": "текст1"
    },
    {
      "parameters": {
        "jsCode": "// --- НАСТРОЙКИ НОРМ (Дневные) ---\nconst NORMS = {\n  cal: 2500,\n  prot: 160,\n  carb: 200,\n  fat: 80\n};\n\nconst items = $input.all();\nconst triggerData = $('Food diary').first().json;\n\nconst user = triggerData.callback_query ? triggerData.callback_query.from : triggerData.message.from;\nconst currentUserId = `${user.first_name} ${user.last_name || ''}`.trim();\n\nconst command = triggerData.callback_query?.data || triggerData.message?.text || '/today';\nconst isWeek = command.includes('week');\n\nlet stats = { cal: 0, prot: 0, carb: 0, fat: 0 };\nlet count = 0;\n\nconst vlaTime = new Date(new Date().getTime() + (10 * 60 * 60 * 1000));\nconst todayStr = vlaTime.toISOString().split('T')[0];\n\nconst weekAgoTime = new Date(vlaTime.getTime() - (6 * 24 * 60 * 60 * 1000));\nconst weekAgoStr = weekAgoTime.toISOString().split('T')[0];\n\nfor (const item of items) {\n  const row = item.json;\n  if (row.User_ID !== currentUserId || !row.Date) continue;\n\n  const rowDate = row.Date.split('T')[0];\n\n  const isMatch = isWeek \n    ? (rowDate >= weekAgoStr && rowDate <= todayStr) \n    : (rowDate === todayStr);\n\n  if (isMatch) {\n    stats.cal += Number(row.Calories) || 0;\n    stats.prot += Number(row.Proteins) || 0;\n    stats.carb += Number(row.Carbs) || 0;\n    stats.fat += Number(row.Fats) || 0;\n    count++;\n  }\n}\n\nfunction generateBar(current, target) {\n  const segments = 10;\n  const progress = Math.min(Math.round((current / target) * segments), segments);\n  const percentage = Math.round((current / target) * 100);\n  return '🟩'.repeat(progress) + '⬜'.repeat(segments - progress) + ` ${percentage}%`;\n}\n\nconst multiplier = isWeek ? 7 : 1;\nconst periodText = isWeek ? `за 7 дней (${weekAgoStr} — ${todayStr})` : `за сегодня (${todayStr})`;\n\nconst message = count > 0 \n  ?[\n      `📊 *Статистика ${periodText}:*`,\n      ``,\n      `🔥 *Калории:* ${Math.round(stats.cal)} / ${NORMS.cal * multiplier}`,\n      generateBar(stats.cal, NORMS.cal * multiplier),\n      ``,\n      `🥩 *Белки:* ${Math.round(stats.prot)}г / ${NORMS.prot * multiplier}г`,\n      generateBar(stats.prot, NORMS.prot * multiplier),\n      ``,\n      `🍚 *Углеводы:* ${Math.round(stats.carb)}г / ${NORMS.carb * multiplier}г`,\n      generateBar(stats.carb, NORMS.carb * multiplier),\n      ``,\n      `🥑 *Жиры:* ${Math.round(stats.fat)}г / ${NORMS.fat * multiplier}г`,\n      generateBar(stats.fat, NORMS.fat * multiplier)\n    ].join('\\n')\n  : `📊 ${isWeek ? 'За последние 7 дней' : 'За сегодня'} записей не найдено.`;\n\nreturn[{\n  json: {\n    text: message,\n    reply_markup: {\n      inline_keyboard: [[\n          { text: '☀️ Сегодня', callback_data: '/today' },\n          { text: '📅 Неделя', callback_data: '/week' }\n        ]\n      ]\n    }\n  }\n}];"
      },
