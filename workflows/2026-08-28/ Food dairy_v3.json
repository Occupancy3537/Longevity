    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst correction = input.message.text; \nconst replyText = input.message.reply_to_message?.text || \"\";\n\n// Извлекаем ID из текста сообщения бота, на которое ответил юзер\nconst idMatch = replyText.match(/\\[ID:(\\d+)\\]/);\nconst entryId = idMatch ? idMatch[1] : null;\n\n// Извлекаем старое описание блюда (оно в первой строке после \"🍽 \")\nconst descMatch = replyText.match(/🍽 (.*?)\\n/);\nconst originalText = descMatch ? descMatch[1] : \"неизвестно\";\n\nreturn {\n  json: {\n    prompt: `Пользователь вносит правку в блюдо. \\nВот старое описание: \"${originalText}\". \\nВот правка пользователя: \"${correction}\". \\nПересчитай калории, БЖУ и микроэлементы с учетом этой правки. Верни ТОЛЬКО строгий JSON.`,\n    Entry_ID: entryId \n  }\n};"
      },
