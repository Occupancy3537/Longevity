    {
      "parameters": {
        "jsCode": "// Получаем текст из сообщения\nconst input = $input.first().json;\nconst userText = input.message?.caption || input.message?.text || '';\n\n// Получаем binary данные\nconst binaryData = $input.first().binary;\n\nreturn {\n  json: {\n    prompt: `Ты нутрициолог. Пользователь прислал фото еды с комментарием: \"${userText}\". \n    Используй комментарий для уточнения состава (вес, ингредиенты, способ приготовления).\n    Оцени вес, БЖУ и микроэлементы.\n    Верни ТОЛЬКО JSON в формате: {\"Meal_description\": \"описание, вес\", \"Calories\": 0, \"Proteins\": 0, \"Carbs\": 0, \"Fats\": 0, \"Магний\": 0, \"Витамин D\": 0, \"Омега-3 (EPA/DHA)\": 0, \"Селен\": 0, \"Йод\": 0, \"Калий\": 0, \"Железо\": 0, \"Кальций\": 0, \"Витамин B12\": 0, \"Витамин К\": 0, \"Витамин Е\": 0, \"Цинк\": 0}`,\n    hasImage: true,\n    userText: userText\n  },\n  binary: binaryData\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        400
      ],
      "id": "bef4e4c3-3259-452c-8f24-b258d3a6a1bf",
