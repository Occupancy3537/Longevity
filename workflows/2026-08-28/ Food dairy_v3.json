    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst query = input.callback_query || input.body?.callback_query;\n\nif (!query) return [];\n\nconst actionData = query.data.split('|'); // Разделяем действие и ID\nconst action = actionData[0];\nconst rowId = actionData[1] || null; // Получаем номер строки\n\nreturn [{\n  json: {\n    callbackQueryId: query.id,\n    chatId: query.message.chat.id,\n    messageId: query.message.message_id,\n    action: action,\n    rowId: rowId, // Теперь у нас есть ID строки в потоке!\n    originalText: query.message.text || \"\",\n    answerText: action === 'edit' ? 'Жду новые данные' : 'Принято'\n  }\n}];"
      },
