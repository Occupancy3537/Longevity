    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet jsonString = null;\n\n// Ищем текст во всех возможных местах\nconst possiblePaths = [\n  'text',\n  'result.text', \n  'message.text',\n  'output.text',\n  'response.text'\n];\n\nfor (const path of possiblePaths) {\n  const keys = path.split('.');\n  let value = input;\n  for (const key of keys) {\n    value = value?.[key];\n  }\n  if (value && typeof value === 'string') {\n    jsonString = value;\n    break;\n  }\n}\n\nif (!jsonString) {\n  console.log('Доступные поля:', JSON.stringify(Object.keys(input), null, 2));\n  throw new Error('Текст не найден. Проверьте консоль для списка полей');\n}\n\ntry {\n  const startIdx = jsonString.indexOf('{');\n  const endIdx = jsonString.lastIndexOf('}');\n  \n  if (startIdx === -1 || endIdx === -1) {\n    throw new Error('JSON не найден');\n  }\n  \n  const parsed = JSON.parse(jsonString.substring(startIdx, endIdx + 1));\n  \n  return {\n    json: {\n      ...input,\n      ...parsed\n    }\n  };\n} catch (error) {\n  throw new Error(`Parse error: ${error.message}`);\n}"
      },
      "id": "bd383cd8-e708-4336-a554-804a6979355a",
