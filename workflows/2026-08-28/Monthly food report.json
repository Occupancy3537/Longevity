    {
      "parameters": {
        "jsCode": "// Input: all month_sum rows where Способ подсчета == 'average'\nfunction toNumber(v) {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number') return v;\n  const n = parseFloat(String(v).replace(',', '.').replace('%',''));\n  return isNaN(n) ? null : n;\n}\n\nconst DIRECTION = {\n  'Calories': 'neutral', 'Proteins': 'higher_better', 'Carbs': 'neutral', 'Fats': 'neutral',\n  'Магний': 'higher_better', 'Витамин D': 'higher_better', 'Омега-3 (EPA/DHA)': 'higher_better',\n  'Селен': 'higher_better', 'Йод': 'higher_better', 'Калий': 'higher_better', 'Железо': 'higher_better',\n  'Кальций': 'higher_better', 'Витамин B12': 'higher_better', 'Витамин К': 'higher_better',\n  'Витамин Е': 'higher_better', 'Цинк': 'higher_better', 'Клетчатка': 'higher_better',\n  'Холестерин': 'lower_better', 'Добавленный сахар': 'lower_better', 'Натрий': 'lower_better',\n  'Кофеин': 'neutral', 'Алкоголь, гр': 'lower_better', 'Насыщенные жиры': 'lower_better', 'Трансжиры': 'lower_better'\n};\n\nconst PCT_MODERATE = 10;\nconst PCT_STRONG = 25;\nconst MIN_ABS_FOR_PCT = 1; // не считать % на почти нулевых базах (напр. трансжиры 0.1г)\n\nconst items = $input.all().map(i => i.json);\nconst avgRows = items\n  .filter(r => (r['Способ подсчета'] || '').toString().trim() === 'average')\n  .sort((a, b) => (a.Date > b.Date ? 1 : -1));\n\nif (avgRows.length < 2) {\n  return [{ json: { warning: 'Недостаточно месяцев для тренда (нужно минимум 2)' } }];\n}\n\nconst prev = avgRows[avgRows.length - 2];\nconst curr = avgRows[avgRows.length - 1];\nconst exclude = ['User_ID', 'Date', 'Способ подсчета'];\nconst metrics = Object.keys(curr).filter(k => !exclude.includes(k));\n\nconst results = [];\nmetrics.forEach(m => {\n  const prevVal = toNumber(prev[m]);\n  const currVal = toNumber(curr[m]);\n  if (prevVal === null || currVal === null || Math.abs(prevVal) < MIN_ABS_FOR_PCT) return;\n\n  const pct = ((currVal - prevVal) / Math.abs(prevVal)) * 100;\n  const absPct = Math.abs(pct);\n  let severity = null;\n  if (absPct >= PCT_STRONG) severity = 'strong';\n  else if (absPct >= PCT_MODERATE) severity = 'moderate';\n  if (!severity) return;\n\n  const direction = DIRECTION[m] || 'neutral';\n  let interpretation = 'изменение';\n  if (direction === 'higher_better') interpretation = pct > 0 ? 'улучшение' : 'ухудшение';\n  if (direction === 'lower_better') interpretation = pct > 0 ? 'ухудшение' : 'улучшение';\n\n  results.push({\n    date_computed: DateTime.now().toISODate(),\n    period_month: curr.Date,\n    metric: m,\n    prev_month_avg: Math.round(prevVal * 100) / 100,\n    this_month_avg: Math.round(currVal * 100) / 100,\n    pct_change: Math.round(pct * 10) / 10,\n    severity, direction, interpretation\n  });\n});\n\nif (results.length === 0) {\n  return [{ json: { info: `Значимых изменений между ${prev.Date} и ${curr.Date} не найдено` } }];\n}\n\nreturn results.map(r => ({ json: r }));"
      },
