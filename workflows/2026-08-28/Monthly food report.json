    {
      "parameters": {
        "jsCode": "// Input: day_sum rows for previous calendar month\nfunction toNumber(v) {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number') return v;\n  const n = parseFloat(String(v).replace(',', '.').replace('%',''));\n  return isNaN(n) ? null : n;\n}\n\nconst now = DateTime.now();\nconst targetMonth = now.minus({ months: 1 });\nconst monthKey = targetMonth.toFormat('yyyy-MM');\n\nconst items = $input.all().map(i => i.json);\nconst rows = items.filter(r => (r['Date'] || '').toString().slice(0, 7) === monthKey);\n\nif (rows.length === 0) {\n  return [{ json: { warning: `Нет данных day_sum за ${monthKey}` } }];\n}\n\nconst exclude = ['User_ID', 'Date'];\nconst fieldSet = new Set();\nrows.forEach(r => Object.keys(r).forEach(k => { if (!exclude.includes(k)) fieldSet.add(k); }));\n\nconst sums = {}, counts = {};\nfieldSet.forEach(f => { sums[f] = 0; counts[f] = 0; });\n\nrows.forEach(r => {\n  fieldSet.forEach(f => {\n    const v = toNumber(r[f]);\n    if (v !== null) { sums[f] += v; counts[f] += 1; }\n  });\n});\n\nconst totalRow = { User_ID: 'Влад Васюк', Date: monthKey, 'Способ подсчета': 'total' };\nconst avgRow = { User_ID: 'Влад Васюк', Date: monthKey, 'Способ подсчета': 'average' };\n\nfieldSet.forEach(f => {\n  totalRow[f] = Math.round(sums[f] * 100) / 100;\n  avgRow[f] = counts[f] > 0 ? Math.round((sums[f] / counts[f]) * 100) / 100 : null;\n});\n\nreturn [{ json: totalRow }, { json: avgRow }];"
      },
