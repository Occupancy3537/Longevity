    {
      "id": "76810b41-e94a-4b91-8d11-cef99c4623b0",
      "name": "Pick Next",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "// Выбор следующего вопроса анамнеза (Батч 4, Группа 2а).\n// Порядок = приоритет категории: препараты → аллергии → наследственность → личный анамнез\n//   → образ жизни → профилактика → происхождение (последним). Внутри категории — по Q_ID.\n// Кап попыток: 3 неотвеченных запроса одного вопроса → он помечается skipped, идём дальше.\nfunction d(v){ const s=String(v||'').trim().slice(0,10); return s.match(/^\\d{4}-\\d{2}-\\d{2}$/)?s:''; }\nfunction catRank(cat){\n  const c = String(cat||'').toLowerCase().trim();\n  if (c.startsWith('препарат') || c.includes('лекарств') || c.includes('добавк')) return 0;\n  if (c.startsWith('аллерг')) return 1;\n  if (c.startsWith('наследственн')) return 2;\n  if (c.startsWith('личный анамнез') || c.startsWith('личн')) return 3;\n  if (c.startsWith('образ жизни')) return 4;\n  if (c.startsWith('профилактика') || c.startsWith('скрин')) return 5;\n  if (c.startsWith('происхожд')) return 9;\n  return 6;\n}\nconst rows = $('Get Anamnesis').all().map(i=>i.json).filter(r=>r.Q_ID);\nrows.sort((a,b)=> (catRank(a.Category)-catRank(b.Category)) || String(a.Q_ID).localeCompare(String(b.Q_ID)));\nconst total = rows.length;\nconst done = rows.filter(r=> ['answered','skipped'].includes(String(r.Status))).length;\nconst answeredReal = rows.filter(r=> String(r.Status)==='answered').length;\nconst today = new Date(Date.now()+10*3600*1000).toISOString().slice(0,10);\nconst daysBetween = (a,b)=> a&&b ? Math.round((new Date(b)-new Date(a))/86400000) : 999;\n\nconst askedRow = rows.find(r=> String(r.Status)==='asked');\nlet pick=null, attempt=1, skip_q_id='';\nif (askedRow){\n  const curAtt = parseInt(askedRow.Attempts,10) || 1;\n  const since = daysBetween(d(askedRow.Asked_Date), today);\n  if (since < 2){\n    return [{ json:{ action:'wait', reason:'ждём ответа на '+askedRow.Q_ID+' ('+since+'д, попытка '+curAtt+'/3)', total, answered:answeredReal } }];\n  }\n  if (curAtt >= 3){\n    skip_q_id = askedRow.Q_ID;                      // 3 запроса без ответа → пропускаем\n    pick = rows.find(r=> String(r.Status)==='pending');\n    attempt = 1;\n  } else {\n    pick = askedRow;                                // повторный запрос того же\n    attempt = curAtt + 1;\n  }\n} else {\n  pick = rows.find(r=> String(r.Status)==='pending');\n  attempt = 1;\n}\nif (!pick){\n  if (skip_q_id) return [{ json:{ action:'skip_only', skip_q_id, today, total, answered:answeredReal, reason:'вопрос пропущен, пул закрыт' } }];\n  return [{ json:{ action:'done', reason:'все вопросы закрыты ('+done+'/'+total+')', total, answered:answeredReal } }];\n}\nconst num = answeredReal + 1;\nconst text = '🧬 Анамнез '+num+'/'+total+'\\n\\n'+pick.Question\n  + '\\n\\n↩️ Ответь на это сообщение (reply / свайп влево). Или просто напиши ответ — я пойму по тегу #'+pick.Q_ID+' ниже.'\n  + (attempt>1 ? '\\n\\n(повторяю — не увидел ответа, попытка '+attempt+'/3)' : '')\n  + '\\n\\n#'+pick.Q_ID;\nreturn [{ json:{ action:'ask', q_id:pick.Q_ID, category:pick.Category, text, attempt, num, total, answered:answeredReal, today, skip_q_id } }];\n"
      }
    },
