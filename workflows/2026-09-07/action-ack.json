      "parameters": {
        "jsCode": "// Отметка выполнения действия. Без неё «Что сработало» меряет совпадение, а не эффект.\nconst q = $input.first().json.query || {};\nconst b = $input.first().json.body || {};\nconst token = q.token || b.token;\nif (token !== 'ak_ryFiYBXUs6') return [{ json: { ok: 'false', error: 'forbidden' } }];\nconst id = String(b.id || q.id || '').trim();\nif (!id) return [{ json: { ok: 'false', error: 'no_id' } }];\nconst doneRaw = (b.done !== undefined ? b.done : q.done);\nconst done = String(doneRaw) === 'true' || doneRaw === true;\nconst parts = id.split('|');\nreturn [{ json: {\n  ok: 'true',\n  Action_ID: id,\n  Date_Issued: parts[0] || '',\n  Title: parts.slice(1).join('|'),\n  Done: done ? 'да' : 'нет',\n  Done_At: new Date(Date.now() + 10*3600*1000).toISOString().slice(0,16).replace('T',' '),\n}}];"
      },
