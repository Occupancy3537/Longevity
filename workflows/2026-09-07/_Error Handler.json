  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        0
      ],
      "id": "e002ee9e-e4ff-4fdf-93ff-b9cf411bb7e3",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst ex = j.execution || {};\nconst wf = j.workflow || {};\nconst err = ex.error || {};\n\nconst vla = new Date(new Date().getTime() + 10 * 3600 * 1000).toISOString().replace('T', ' ').slice(0, 19);\nconst url = ex.url || '';\nconst errMsg = String(err.message || err.description || 'неизвестная ошибка').slice(0, 900);\nconst stack = String(err.stack || '').slice(0, 1800);\nconst node = (err.node && err.node.name) ? err.node.name : (ex.lastNodeExecuted || '?');\n\nconst tg =\n  '🔴 ОШИБКА workflow\\n\\n' +\n  'Workflow: ' + (wf.name || wf.id || '?') + '\\n' +\n  'Нода: ' + node + '\\n' +\n  'Время (Влад): ' + vla + '\\n\\n' +\n  'Ошибка: ' + errMsg + '\\n\\n' +\n  (url ? ('Прогон: ' + url) : ('Execution ID: ' + ex.id));\n\nreturn [{\n  json: {\n    Timestamp: vla,\n    Workflow: wf.name || wf.id || '?',\n    Node: node,\n    Error_Message: errMsg,\n    Execution_ID: String(ex.id || ''),\n    Execution_URL: url,\n    Stack: stack,\n    Status: 'новая',\n    _telegram: tg,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ],
      "id": "0129cef5-3be3-40d9-9bd4-4f7c5d2d1caa",
      "name": "Format Error"
    },
    {
      "parameters": {
        "chatId": "8956401",
        "text": "={{ $json._telegram }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
