    {
      "parameters": {
        "jsCode": "let text = $json.output || \"\";\n\n// 1. Превращаем <br> и <p> в нормальные текстовые переносы\ntext = text.replace(/<br\\s*\\/?>/gi, '\\n');\ntext = text.replace(/<\\/?p>/gi, '\\n\\n');\n\n// 2. Спасаем жирный шрифт (Markdown в HTML)\ntext = text.replace(/\\*\\*(.*?)\\*\\*/g, '<b>$1</b>');\ntext = text.replace(/\\*/g, '');\n\n// 3. СПАСАЕМ МЕДИЦИНСКИЕ АНАЛИЗЫ (знаки < и >)\n// Если после < идет пробел или цифра - это точно математика, а не тег\ntext = text.replace(/<(?=\\s|[0-9])/g, '&lt;');\n// Аналогично для знака >\ntext = text.replace(/(?<=\\s|[0-9])>/g, '&gt;');\n\n// 4. Оставляем только разрешенные теги Телеграма\nconst allowedTags = \"b|strong|i|em|u|s|strike|del|a|code|pre\";\nconst sanitizeRegex = new RegExp(`<\\/?(?!(?:${allowedTags})\\\\b)[a-z0-9]+[^>]*>`, 'gi');\ntext = text.replace(sanitizeRegex, '');\n\n// 5. 🏗 АВТО-БАЛАНСИРОВЩИК ТЕГОВ (Лечит ошибку Unmatched end tag)\nconst stack =[];\nconst tagRegex = /<\\/?([a-z]+)[^>]*>/gi;\nlet match;\n\n// Проходим по всем тегам в тексте\nwhile ((match = tagRegex.exec(text)) !== null) {\n  const tag = match[1].toLowerCase();\n  const isClosing = match[0].startsWith('</');\n\n  if (!isClosing) {\n    // Если тег открылся - кладем его в \"память\"\n    stack.push(tag);\n  } else {\n    // Если тег закрылся - убираем его из памяти\n    const lastIndex = stack.lastIndexOf(tag);\n    if (lastIndex !== -1) {\n      stack.splice(lastIndex, 1); \n    }\n  }\n}\n\n// Все теги, которые остались в \"памяти\" - нейросеть забыла закрыть!\n// Аккуратно закрываем их в самом конце текста в обратном порядке\nfor (let i = stack.length - 1; i >= 0; i--) {\n  text += `</${stack[i]}>`;\n}\n\n// 6. Убираем лишние пустые строки\ntext = text.replace(/\\n{3,}/g, '\\n\\n');\n\nreturn { \n  json: { \n    ...$json,\n    output: text.trim() \n  } \n};"
      },
