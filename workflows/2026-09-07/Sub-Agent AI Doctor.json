      "parameters": {
        "jsCode": "// 1. Берем медкарту из Таблицы\nconst sheetData = $input.first().json;\n\n// 2. Берем оригинальное сообщение из стартового триггера\nconst triggerData = $('Главврач').first().json;\n\n// 3. БЕРЕМ КАРТИНКУ из стартового триггера (если она есть)\nconst binaryData = $('Главврач').first().binary;\n\n// Формируем финальный пакет для ИИ\nlet result = {\n  json: {\n    medical_record: sheetData,\n    user_message: triggerData.message?.caption || triggerData.message?.text || \"Посмотри на это фото.\",\n    telegram_id: triggerData.message?.from?.id,\n    chat_id: triggerData.message?.chat?.id\n  }\n};\n\n// Если картинка была, аккуратно приклеиваем её к ответу\nif (binaryData) {\n  result.binary = binaryData;\n}\n\nreturn [result];"
      },
