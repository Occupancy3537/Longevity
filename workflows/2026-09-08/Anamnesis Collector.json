    {
      "id": "76810b41-e94a-4b91-8d11-cef99c4623b0",
      "name": "Pick Next",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "\n// Выбор следующего вопроса анамнеза. Один вопрос в день, повтор раз в 2 дня пока не ответят.\nfunction d(v){ const s=String(v||'').trim().slice(0,10); return s.match(/^\\d{4}-\\d{2}-\\d{2}$/)?s:''; }\nconst rows = $('Get Anamnesis').all().map(i=>i.json).filter(r=>r.Q_ID);\nrows.sort((a,b)=>String(a.Q_ID).localeCompare(String(b.Q_ID)));\nconst total = rows.length;\nconst answered = rows.filter(r=>String(r.Status)==='answered').length;\nconst today = new Date(Date.now()+10*3600*1000).toISOString().slice(0,10);\nconst daysBetween = (a,b)=> a&&b ? Math.round((new Date(b)-new Date(a))/86400000) : 999;\n\nconst askedRow = rows.find(r=>String(r.Status)==='asked');\nlet pick=null, attempt=1;\nif (askedRow) {\n  const since = daysBetween(d(askedRow.Asked_Date), today);\n  if (since < 2) {\n    return [{ json: { action:'wait', reason:'ждём ответа на '+askedRow.Q_ID+' ('+since+'д)', total, answered } }];\n  }\n  pick = askedRow;                       // повторный запрос того же\n  attempt = (parseInt(askedRow.Attempts,10)||1) + 1;\n} else {\n  pick = rows.find(r=>String(r.Status)==='pending');\n  attempt = 1;\n}\nif (!pick) {\n  return [{ json: { action:'done', reason:'все вопросы закрыты', total, answered } }];\n}\nconst num = answered + 1;\nconst text = '🧬 Анамнез '+num+'/'+total+'\\n\\n'+pick.Question\n  + '\\n\\n↩️ Ответь reply на это сообщение (свайп влево).'\n  + (attempt>1 ? '\\n\\n(повторяю вопрос — не увидел ответа)' : '')\n  + '\\n\\n#'+pick.Q_ID;\nreturn [{ json: { action:'ask', q_id:pick.Q_ID, category:pick.Category, text, attempt, num, total, answered, today } }];\n"
      }
    },
