    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message || {};\nconst replied = ((msg.reply_to_message || {}).text) || '';\nconst m = replied.match(/#(A\\d\\d)/);\nconst answer = String(msg.text || '').trim();\nconst today = new Date(Date.now() + 10*3600*1000).toISOString().slice(0,10);\nif (!m || !answer) throw new Error('anamnesis: нет q_id или пустой ответ');\n\n// card-service: сырьё анамнеза сохраняется параллельно, не блокируя запись ответа\n// (Phase 2, CARD_ARCHITECTURE_PLAN_2026-09-13.md). Недоступен/медленный -> тихо пропускаем.\nthis.helpers.httpRequest({\n  method: 'POST',\n  url: 'http://card-service:8080/ingest',\n  json: true,\n  body: { channel: 'telegram', raw_text: answer, person_id: 'self' },\n  timeout: 5000,\n}).catch(() => {});\n\nreturn [{ json: { q_id: m[1], answer, today, chat_id: msg.chat.id } }];"
      },
