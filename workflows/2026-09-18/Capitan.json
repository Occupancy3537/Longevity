    {
      "parameters": {
        "jsCode": "// Держим индикатор «печатает…» пока агент думает: Telegram гасит его через ~5 сек,\n// поэтому обновляем каждые 4.5 сек. ~9 циклов ≈ 40 сек (под лимитом задачи 60 сек).\nconst token = '8413234787:AAEUX3sgJcD13_N8QTJMJkbBHmwbAXW-bP4';\nlet chatId;\ntry { chatId = $('Telegram Trigger').first().json.message.chat.id; } catch (e) {}\nif (!chatId) return [{ json: { typing: 'no chat id' } }];\nfor (let i = 0; i < 9; i++) {\n  try {\n    await fetch('https://api.telegram.org/bot' + token + '/sendChatAction', {\n      method: 'POST',\n      headers: { 'content-type': 'application/json' },\n      body: JSON.stringify({ chat_id: chatId, action: 'typing' }),\n    });\n  } catch (e) {}\n  if (i < 8) await new Promise(r => setTimeout(r, 4500));\n}\nreturn [{ json: { typing: 'done', cycles: 9 } }];"
      },
