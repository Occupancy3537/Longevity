    {
      "parameters": {
        "jsCode": "// Берем ВСЁ оригинальное сообщение из Телеграма\nconst originalItem = $input.first().json;\nconst userText = originalItem.message?.caption || originalItem.message?.document?.file_name || 'Документ без описания';\n\nreturn {\n  json: {\n    ...originalItem, // Оставляем все ID, Chat ID и прочие важные данные\n    intent: 'TEST',  // ЖЕСТКО задаем маршрут для финального Switch\n    userText: userText\n  },\n  binary: $input.first().binary // Бережно проносим сам PDF/CSV дальше\n};"
      },
