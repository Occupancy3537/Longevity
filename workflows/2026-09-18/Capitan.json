    {
      "parameters": {
        "jsCode": "// Capitan — sticky-маршрутизация с настоящей сессией (Static Data работает: id воркфлоу <=21).\n// Проблема, которую закрываем: продолжение разговора с доктором уезжало в Регистратора,\n// когда классификатор видел в тексте цифру/слово-триггер (был мусор в Doctor_Notes).\n// Два сигнала «это продолжение, форсим SYMPTOM»:\n//   1) reply на сообщение бота (не вопрос анамнеза) — сильный сигнал, как раньше, форсит всегда;\n//   2) в этом чате <15 мин назад уже был SYMPTOM-роут (сессия в Static Data) — форсит ТОЛЬКО\n//      если классификатор сказал TEST (или ничего). CALENDAR/SLEEP во время сессии не трогаем.\n// Любой из этих случаев отключается, если в сообщении: явная команда записи, слэш-команда\n// или прикреплён файл/фото (это самостоятельные запросы).\nconst SESSION_TTL_MS = 15 * 60 * 1000;\nconst PURGE_MS = 6 * 60 * 60 * 1000;\nconst sd = $getWorkflowStaticData('global');\nsd.session = sd.session || {};\nconst now = Date.now();\n\nconst out = $input.all().map(entry => {\n  const item = { ...entry.json };\n  const msg = item.message || (item.body && item.body.message) || {};\n  const chatId = msg.chat && msg.chat.id;\n  const raw = String(msg.text || msg.caption || '');\n  const t = raw.toLowerCase();\n\n  const explicitLog = /(запиши|занеси|добав[ьи][^.]{0,20}карт|сохрани|зафиксир)/.test(t);\n  const explicitCmd = /^\\s*\\//.test(raw);\n  const hasFile = !!msg.photo || !!msg.document;\n\n  const rtm = msg.reply_to_message;\n  const replyToBot = !!(rtm && rtm.from && rtm.from.is_bot &&\n    !/#A\\d{2}/.test(String(rtm.text || rtm.caption || '')));\n\n  const decided0 = String(item.text || item.intent || '').toUpperCase();\n  const prev = chatId != null ? sd.session[chatId] : null;\n  const sessionSticky = !!(prev && prev.route === 'SYMPTOM' && (now - prev.ts) < SESSION_TTL_MS);\n  const forceBySession = sessionSticky && (decided0.indexOf('TEST') >= 0 || !decided0);\n\n  if (!explicitLog && !explicitCmd && !hasFile && (replyToBot || forceBySession)) {\n    item.text = 'SYMPTOM';\n    item._sticky_route = replyToBot ? 'reply-to-bot -> SYMPTOM' : 'сессия <15мин, класс-р сказал TEST -> SYMPTOM';\n  }\n\n  if (chatId != null) {\n    const decided = String(item.text || item.intent || '').toUpperCase();\n    let route = 'OTHER';\n    if (decided.indexOf('SYMPTOM') >= 0) route = 'SYMPTOM';\n    else if (decided.indexOf('TEST') >= 0) route = 'TEST';\n    else if (decided.indexOf('CALENDAR') >= 0) route = 'CALENDAR';\n    else if (decided.indexOf('SLEEP') >= 0) route = 'SLEEP';\n    sd.session[chatId] = { route, ts: now };\n  }\n  return { json: item };\n});\n\nfor (const k of Object.keys(sd.session)) {\n  if (now - (sd.session[k].ts || 0) > PURGE_MS) delete sd.session[k];\n}\n\nreturn out;\n"
      },
