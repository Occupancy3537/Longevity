    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst ex = j.execution || {};\nconst wf = j.workflow || {};\nconst err = ex.error || {};\n\nconst vla = new Date(new Date().getTime() + 10 * 3600 * 1000).toISOString().replace('T', ' ').slice(0, 19);\nconst url = ex.url || '';\nconst errMsg = String(err.message || err.description || 'неизвестная ошибка').slice(0, 900);\nconst stack = String(err.stack || '').slice(0, 1800);\nconst node = (err.node && err.node.name) ? err.node.name : (ex.lastNodeExecuted || '?');\nconst wfName = wf.name || wf.id || '?';\n\n// A5: инфра-ошибки — тихо (disable_notification), здоровье/безопасность — со звуком.\nconst HEALTH_SAFETY = /watchdog|advisor|доктор|doctor|capitan|капитан|registrar|регистратор|reports|backup alert|system check|anamnesis|анамнез|phenoage/i;\nconst silent = !HEALTH_SAFETY.test(wfName);\n\nconst tg =\n  (silent ? '🔇 ' : '🔴 ') + 'ОШИБКА workflow\\n\\n' +\n  'Workflow: ' + wfName + '\\n' +\n  'Нода: ' + node + '\\n' +\n  'Время (Влад): ' + vla + '\\n\\n' +\n  'Ошибка: ' + errMsg + '\\n\\n' +\n  (url ? ('Прогон: ' + url) : ('Execution ID: ' + ex.id));\n\nreturn [{ json: {\n  Timestamp: vla, Workflow: wfName, Node: node, Error_Message: errMsg,\n  Execution_ID: String(ex.id || ''), Execution_URL: url, Stack: stack, Status: 'новая',\n  _telegram: tg, _silent: silent,\n} }];"
      },
