    {
      "id": "a97f2e9b-364d-4acc-8c25-5886381d0822",
      "name": "Assess",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        80
      ],
      "parameters": {
        "jsCode": "\nconst sd = $getWorkflowStaticData('global');\nsd.backup = sd.backup || {};\nconst now = Date.now();\nconst src = $json.__src || ($json.headers ? 'webhook' : 'schedule');\nlet alert = '';\n\nif (src === 'webhook') {\n  const b = $json.body || $json;\n  const __bt = b.token;\n  if (__bt !== '4bu6zMq9CxzhxA1b4WcB') return [{ json: { alert: '', has_alert: false } }];\n  sd.backup = { ts: now, result: String(b.result||'?'), detail: String(b.detail||''), stamp: String(b.ts||'') };\n  if (sd.backup.result === 'failed') {\n    alert = '⚠️ <b>Ночной бэкап: СБОЙ</b>\\n\\nЭтап(ы): ' + (sd.backup.detail || 'неизвестно') + '\\nВремя: ' + sd.backup.stamp + ' UTC\\n\\nЛог: nightly_backup.log на VPS.';\n  } else if (sd.backup.result === 'partial') {\n    alert = 'ℹ️ <b>Бэкап: один провайдер не сработал</b>\\n\\n' + (sd.backup.detail||'') + ' · ' + sd.backup.stamp + ' UTC.\\nБэкап цел на остальных облаках. Проверь авторизацию rclone, если повторится.';\n  } else if (sd.backup.result !== 'ok') {\n    alert = '⚠️ Бэкап вернул статус «' + sd.backup.result + '» — ' + (sd.backup.detail||'') ;\n  }\n} else {\n  const ageH = sd.backup.ts ? (now - sd.backup.ts) / 3600000 : 999;\n  if (ageH > 26) {\n    alert = '⚠️ <b>Ночной бэкап не отработал</b>\\n\\nПоследний пинг: ' + (sd.backup.stamp || 'никогда') + ' (' + Math.round(ageH) + 'ч назад).\\nПроверь крон и nightly_backup.log.';\n  } else if (sd.backup.result === 'failed') {\n    alert = '⚠️ <b>Ночной бэкап: последний прогон со сбоем</b>\\n\\n' + (sd.backup.detail||'') + ' · ' + (sd.backup.stamp||'');\n  }\n}\nreturn [{ json: { alert, has_alert: !!alert, backup_state: sd.backup } }];\n"
      }
    },
