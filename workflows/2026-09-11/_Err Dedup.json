        220,
        0
      ],
      "parameters": {
        "jsCode": "\nconst sd = $getWorkflowStaticData('global');\nsd.seen = sd.seen || {};\nconst b = $json.body || $json;\nconst __tok = b.token;\nif (__tok !== '8beNA4tqEdqhpjtUqCUM') return [{ json: { send: false, text: '', silent: true } }];\nconst wf = String(b.wf || '?'), node = String(b.node || '?');\nconst key = wf + '|' + node;\nconst now = Date.now();\nconst last = sd.seen[key] || 0;\nconst mins = (now - last) / 60000;\nconst suppress = mins < 60;\nsd.seen[key] = now;\nif (suppress) sd.seen[key + ':burst'] = (sd.seen[key + ':burst'] || 0) + 1;\nelse sd.seen[key + ':burst'] = 0;\nconst burst = sd.seen[key + ':burst'] || 0;\n\nlet raw = String(b.telegram || ('Ошибка: ' + wf + ' / ' + node));\nlet send = !suppress;\nif (suppress && burst > 0 && mins >= 55) {\n  raw = '🔁 ' + wf + ' / ' + node + ' — серия ошибок продолжается (' + burst + ' за ~час). Загляни в Error_Log.';\n  sd.seen[key] = now; sd.seen[key + ':burst'] = 0;\n  send = true;\n}\n// экранируем под parse_mode=HTML (текст ошибок содержит _ * [ ] < > и т.п.)\nconst text = raw.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn [{ json: { send, text, silent: !!b.silent, burst } }];\n"
      }
    },
