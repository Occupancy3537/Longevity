      "parameters": {
        "jsCode": "let temp = null;\nlet hum = null;\nlet pm25 = null;\n// В ответе массив, берем первый элемент\nlet data = $input.first().json[0] || $input.first().json; \nconst targetDeviceId = '1c92a9dc-cd69-448a-98ba-f202814f50b0';\n\nif (data && data.devices) {\n  for (let device of data.devices) {\n    // Парсим свойства только нужного устройства\n    if (device.id === targetDeviceId && device.properties) {\n      for (let prop of device.properties) {\n        if (prop.parameters && prop.state && prop.state.value !== null) {\n          if (prop.parameters.instance === 'temperature') temp = prop.state.value;\n          if (prop.parameters.instance === 'humidity') hum = prop.state.value;\n          if (prop.parameters.instance === 'pm2.5_density') pm25 = prop.state.value;\n        }\n      }\n      break; // Прерываем цикл устройств, так как нужное уже найдено\n    }\n  }\n}\n\nreturn {\n  \"Дата\": new Date().toISOString(),\n  \"Температура\": temp,\n  \"Влажность\": hum,\n  \"PM2.5\": pm25\n};"
      },
