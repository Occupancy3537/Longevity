          "jsCode": "// === НАСТРОЙКИ ===\nconst TIMEZONE_OFFSET_HOURS = 10; // Владивосток\nconst DAYS_TO_ANALYZE = 7;\nconst DATE_FIELD = 'Date';\nconst USER_FIELD = 'User_ID';      // Название колонки с именем\nconst TARGET_USER = 'Влад Васюк';  // Имя пользователя для отчета\n\n// === ЛОГИКА ===\nconst now = new Date();\nconst nowInVl = new Date(now.getTime() + (TIMEZONE_OFFSET_HOURS * 60 * 60 * 1000));\nconst startInVl = new Date(nowInVl);\nstartInVl.setDate(startInVl.getDate() - DAYS_TO_ANALYZE);\nstartInVl.setHours(0, 0, 0, 0);\n\nconst allItems = $input.all();\nconst uniqueDates = new Set();\nconst filteredItems = [];\n\nfor (const item of allItems) {\n  // 1. ПРОВЕРКА ПОЛЬЗОВАТЕЛЯ\n  // Приводим к строке, убираем лишние пробелы и сравниваем\n  const userName = String(item.json[USER_FIELD] || '').trim();\n  if (userName !== TARGET_USER) {\n    continue; // Если это не Влад Васюк — пропускаем строку\n  }\n\n  // 2. ПРОВЕРКА ДАТЫ\n  const rawDate = item.json[DATE_FIELD];\n  if (!rawDate) continue;\n\n  let rowDate = new Date(rawDate);\n  if (isNaN(rowDate.getTime())) continue;\n\n  const rowDateInVl = new Date(rowDate.getTime() + (TIMEZONE_OFFSET_HOURS * 60 * 60 * 1000));\n\n  if (rowDateInVl >= startInVl && rowDateInVl <= nowInVl) {\n    filteredItems.push(item);\n    const dateKey = rowDateInVl.toISOString().split('T')[0];\n    uniqueDates.add(dateKey);\n  }\n}\n\n// === РЕЗУЛЬТАТ ===\nif (filteredItems.length === 0) {\n  return [{ json: { noData: true, daysTracked: 0 } }];\n}\n\nconst daysCount = uniqueDates.size;\n\nreturn filteredItems.map(item => ({\n  json: {\n    ...item.json,\n    daysTracked: daysCount\n  }\n}));"
