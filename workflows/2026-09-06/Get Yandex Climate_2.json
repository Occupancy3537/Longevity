    {
      "parameters": {
        "jsCode": "let temp = null;\nlet hum = null;\nlet pm25 = null;\n\n// Теперь в ответе приходит объект самого устройства\nlet device = $input.first().json;\n\nif (device && device.properties) {\n  for (let prop of device.properties) {\n    if (prop.parameters && prop.state && prop.state.value !== null) {\n      if (prop.parameters.instance === 'temperature') temp = prop.state.value;\n      if (prop.parameters.instance === 'humidity') hum = prop.state.value;\n      if (prop.parameters.instance === 'pm2.5_density') pm25 = prop.state.value;\n    }\n  }\n}\n\nreturn {\n  \"Дата\": new Date().toISOString(),\n  \"Температура\": temp,\n  \"Влажность\": hum,\n  \"PM2.5\": pm25\n};"
      },
