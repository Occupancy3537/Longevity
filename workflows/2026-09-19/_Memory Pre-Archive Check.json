    {
      "id": "5630499e-3720-4d70-9e3a-034dec6f34cd",
      "name": "Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Зовёт card-service /health-check/pre-archive (Phase П4 §6.2), не подключённый\n// к расписанию ни разу до сегодня. w3_question — эпизод с критическим паттерном,\n// молчавший 90+ дней: тихо забыть нельзя, нужен ответ Влада. \"archived\" — не шумим.\nfunction pluralRu(n, one, few, many) {\n  const n10 = Math.abs(n) % 10, n100 = Math.abs(n) % 100;\n  if (n100 > 10 && n100 < 20) return many;\n  if (n10 > 1 && n10 < 5) return few;\n  if (n10 === 1) return one;\n  return many;\n}\n\nlet items = null, callError = null;\ntry {\n  items = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'http://card-service:8080/health-check/pre-archive',\n    json: true,\n    timeout: 15000,\n  });\n} catch (e) {\n  callError = String((e && e.message) || e);\n}\n\nif (callError) {\n  return [{ json: { has_alert: true,\n    alert: '⚠️ Проверка памяти (pre-archive) не смогла достучаться до card-service: ' + callError } }];\n}\n\nconst w3 = (Array.isArray(items) ? items : []).filter(i => i && i.action === 'w3_question');\nif (!w3.length) return [{ json: { has_alert: false, alert: '' } }];\n\nconst lines = w3.map(i => '• ' + (i.symptom_key || '?') + ' (id ' + i.episode_id + ') — ' + i.reason);\nconst text = '🗂 Память: ' + w3.length + ' ' + pluralRu(w3.length, 'эпизод', 'эпизода', 'эпизодов') +\n  ' с критическим паттерном молчат 90+ дней. Тихо архивировать нельзя — подтверди, что можно забыть:\\n\\n' +\n  lines.join('\\n');\nreturn [{ json: { has_alert: true, alert: text } }];"
      }
    },
    {
